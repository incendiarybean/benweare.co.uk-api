{
    "compilerOptions": {
        // Environment setup & latest features
        "lib": [
            "ESNext"
        ],
        "target": "ESNext",
        "module": "nodenext",
        "moduleDetection": "force",
        "jsx": "react-jsx",
        "allowJs": true,
        "types": [
            "node"
        ],
        // Bundler mode
        "moduleResolution": "nodenext",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "esModuleInterop": true,
        // Best practices
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noPropertyAccessFromIndexSignature": true,
        "paths": {
            "@server": [
                "./src/server/index.ts"
            ],
            "@schema": [
                "./src/schema/index.ts"
            ],
            "@handlers/*": [
                "./src/handlers/*"
            ],
            "@routes/*": [
                "./src/routes/*"
            ],
            "@workers/*": [
                "./src/workers/*"
            ],
            "@common/*": [
                "./src/common/*"
            ],
            "@utils/*": [
                "./src/common/utils/*"
            ]
        },
    },
    "ts-node": {
        "files": true
    },
    "exclude": [
        "*.config.js",
        "build",
        "coverage"
    ]
}