{
    "name": "benweare.co.uk-server",
    "version": "2.4.0",
    "private": true,
    "main": "./build/index.js",
    "type": "module",
    "dependencies": {
        "@discordjs/voice": "0.19.0",
        "axios": "1.16.0",
        "benweare.co.uk-client": "1.6.2",
        "cors": "2.8.6",
        "discord.js": "14.26.4",
        "express": "5.2.0",
        "ffmpeg-static": "5.1.0",
        "jsdom": "29.1.1",
        "libsodium-wrappers": "0.7.10",
        "socket.io": "4.8.3",
        "swagger-ui-express": "5.0.1",
        "uuid": "14.0.0"
    },
    "scripts": {
        "start": "node -r dotenv/config .",
        "offline": "nodemon ./src/index.ts",
        "build": "tsc -p ./ && tsc-alias -p ./tsconfig.json",
        "lint": "eslint .",
        "lint-fix": "eslint --fix .",
        "test": "vitest"
    },
    "browserslist": {
        "production": [
            ">0.2%",
